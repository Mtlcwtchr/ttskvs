<!-- Одна строка текста. Tри компонента используют её с разными дефолтами:
     Caption (подпись), Note (приписка), Label (обычная строка).
     height="auto" = высота строки по кеглю (Layout.metrics.lineFactor).
     wrap: horizontalOverflow="Wrap" — для многострочных описаний. По умолчанию
     Overflow, как у TTS: одна строка не переносится, а autosizing помогает
     ей уместиться в ячейку без вылета. resizeTextForBestFit наследуется из Defaults. -->
<Text width="{{WIDTH}}" height="{{HEIGHT}}" font="{{FONT}}" fontSize="{{FONT_SIZE}}" alignment="{{ALIGNMENT}}"
      color="{{COLOR}}" horizontalOverflow="{{OVERFLOW}}">{{CONTENT}}</Text>
