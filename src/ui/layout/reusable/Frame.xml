<!-- Рамка-фаска: цветной блок, ребёнок внутри отступа. Tолщина рамки — padding,
     а не «ребёнок на 6 пикселей меньше»: пересчитывать ничего не надо.
     Заменяет золотые бевелы из референса, пока нет 9-slice PNG. -->
<Box width="{{WIDTH}}" height="{{HEIGHT}}" color="{{BORDER_COLOR}}" padding="{{BORDER}}">{{CONTENT}}</Box>
