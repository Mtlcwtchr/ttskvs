<!-- Поле правки. colors/textColor обязательны: по умолчанию TTS рисует поле
     БЕЛЫМ с тёмно-серым текстом (#323232) — на тёмном листе это белая заплатка.
     lineType — только SingleLine/MultiLineSubmit/MultiLineNewLine; прежнее
     "MultiLine" было невалидным значением и молча игнорировалось. -->
<InputField id="{{ID}}" width="{{WIDTH}}" height="{{HEIGHT}}" fontSize="{{FONT_SIZE}}"
            colors="{{COLORS}}" textColor="{{TEXT_COLOR}}" caretColor="caret"
            onEndEdit="{{ON_END_EDIT}}" characterValidation="{{VALIDATION}}"
            interactable="true" readOnly="false" lineType="{{LINE_TYPE}}" text="{{VALUE}}" />
