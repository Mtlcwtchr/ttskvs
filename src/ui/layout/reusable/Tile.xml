<!-- Плитка характеристики (4A, колонка 1): подпись капсом, крупное значение,
     пилюля модификатора снизу. -->
<Col width="{{WIDTH}}" height="{{HEIGHT}}" color="{{COLOR}}" padding="{{PADDING}}" gap="1" align="topleft">
  <Box width="fill" height="{{LABEL_HEIGHT}}">
    <Caption height="fill" fontSize="{{LABEL_FONT_SIZE}}" alignment="MiddleCenter" color="{{LABEL_COLOR}}">{{LABEL}}</Caption>
  </Box>
  <Box width="fill" height="fill">{{VALUE}}</Box>
  {{SUB_BLOCK}}
</Col>
