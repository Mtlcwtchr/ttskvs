<!-- Плитка: подпись, значение (слот — текст в просмотре, поле в визарде),
     приписка. Характеристики, броня, бонусы атаки. -->
<Box width="{{WIDTH}}" height="{{HEIGHT}}" color="{{COLOR}}">
  <Stack padding="4 4 4 4" spacing="0">
    <Caption fontSize="8" alignment="MiddleCenter" color="{{LABEL_COLOR}}">{{LABEL}}</Caption>
    {{VALUE}}
    {{SUB_BLOCK}}
  </Stack>
</Box>
