<!-- «Открытое место» в рейке (4A: open seat): создаёт заготовку и сразу
     открывает визард. Данных не требует, поэтому вся описана разметкой. -->
<Box width="{{SIZE}}" height="{{SIZE}}" color="emptySeatBorder" padding="1">
  <Button id="create_character" width="fill" height="fill" colors="seatStates" textColor="seatText"
          textAlignment="MiddleCenter" fontSize="30" onClick="createCharacter">+</Button>
</Box>
